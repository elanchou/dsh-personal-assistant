# Only needed when you run the workers by hand. Inside DSH the plugin passes all of this
# from the DSH credential store, so you normally do not create a .env at all.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DSH_BASE_URL=http://127.0.0.1:3080
DSH_VOICE_BRIDGE_TOKEN=
AGENT_NAME=dsh-voice
TG_API_ID=
TG_API_HASH=
TG_SESSION=dsh-voice
