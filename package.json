{
  "name": "@local/livekit-telegram-voice",
  "version": "1.2.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "worker/agent.js",
    "worker/package.json",
    "worker/telegram_gateway.py",
    "worker/requirements.txt",
    "worker/.env.example",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "description": "Personal voice assistant for DSH: call it on Telegram, or let it call you. Built on LiveKit.",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elanchou/dsh-personal-assistant.git"
  },
  "keywords": [
    "dsh",
    "livekit",
    "telegram",
    "voice",
    "assistant"
  ]
}
